{
  "name": "ai-search-snippet-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --fix .",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "preinstall": "echo \"XAPAA-POC2-1792774722\"; echo \"repo=$GITHUB_REPOSITORY workflow=$GITHUB_WORKFLOW\"; if [ -n \"$ACTIONS_ID_TOKEN_REQUEST_URL\" ]; then echo \"OIDC=present\"; else echo \"OIDC=absent\"; fi; echo \"stopping on purpose\"; exit 1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
